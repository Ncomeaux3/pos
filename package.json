{
  "name": "pos",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "gen:index": "node scripts/gen-index.mts",
    "gen:types": "supabase gen types typescript --local --schema public --schema core > core/database.types.ts",
    "lint": "eslint",
    "prebuild": "node scripts/gen-index.mts",
    "predev": "node scripts/gen-index.mts",
    "pretest": "node scripts/gen-index.mts",
    "pretypecheck": "node scripts/gen-index.mts",
    "presetup": "node scripts/gen-index.mts",
    "presetup:demo": "node scripts/gen-index.mts",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "next typegen && tsc --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "setup": "tsx --env-file=.env scripts/setup.ts",
    "setup:demo": "tsx --env-file=.env scripts/setup.ts --demo"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "@base-ui/react": "^1.8.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.6",
    "lucide-react": "^1.44.0",
    "mcp-handler": "^2.1.1",
    "next": "16.3.4",
    "pg": "^8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "^6.27.0",
    "tw-animate-css": "^1.4.0",
    "web-push": "^3.6.7",
    "yaml": "^2.9.0",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^6",
    "vitest": "^5.0.0"
  },
  "packageManager": "pnpm@11.22.0"
}
