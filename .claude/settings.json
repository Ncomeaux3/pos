{
  "permissions": {
    "allow": [
      "Bash(git status*)", "Bash(git diff*)", "Bash(git log*)", "Bash(git add*)", "Bash(git commit*)",
      "Bash(npm test*)", "Bash(npm run lint*)", "Bash(npm run typecheck*)",
      "Bash(pytest*)", "Bash(ruff*)",
      "Read", "Grep", "Glob"
    ],
    "deny": [
      "Read(.env)", "Read(.env.local)", "Read(.env.*.local)", "Read(.env.production*)",
      "Read(**/*.pem)", "Read(**/*.key)",
      "Bash(git push --force*)", "Bash(rm -rf*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [{ "type": "command", "command": "bash .claude/hooks/protect-migrations.sh" }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [{ "type": "command", "command": "bash .claude/hooks/no-em-dash.sh" }]
      }
    ]
  }
}
