# Infrastructure secrets only. Account credentials for providers (Anthropic,
# Voyage, Resend, SimpleFIN, Strava...) are entered on Settings > Connections
# and stored encrypted in core.connections. Never add a provider key here.
#
# cp .env.example .env and fill every key. pnpm setup checks that none is blank.
# For local development, `supabase status` prints the first four values.

# Supabase. Local defaults are the well known dev values printed by
# `supabase status`; production values come from the project dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection, used by scripts, migrations, and tests.
# Local: postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Vercel: the Supabase pooler in transaction mode, port 6543. Session mode
# (port 5432) caps clients at the Pool Size and serverless instances exhaust it.
DATABASE_URL=

# The one account allowed to log in. Every other address is rejected.
OWNER_EMAIL=

# Base64 32 byte key for core/crypto.ts. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rotating this makes every stored connection credential unreadable.
ENCRYPTION_KEY=

# Shared secret on /api/cron/nightly and the dashboard Run now button.
# Generate with: openssl rand -hex 32
CRON_SECRET=

# Bearer token for /api/mcp, used by Claude Code.
# Generate with: openssl rand -hex 32
MCP_TOKEN=

# Web push. Infrastructure rather than an account credential, so these live
# here and not in core.connections. Generate a pair with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# Until both are set, Settings > Notifications says push is not configured and
# the sender skips it. Changing them invalidates every subscribed device, which
# then has to press the button again.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Where a push service should complain if this app misbehaves. Defaults to
# mailto:OWNER_EMAIL.
VAPID_SUBJECT=

# OAuth client credentials, one pair per oauth2 provider, named
# <ID>_CLIENT_ID and <ID>_CLIENT_SECRET after the integration id. Blank until
# the provider's app is registered (docs/SETUP-INTEGRATIONS.md).
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Sender for digest emails. Optional: defaults to onboarding@resend.dev, which
# Resend lets any account send from, so leave it blank until a domain is verified.
RESEND_FROM=

# Mail leaves production and nowhere else. The e2e suite presses Run now, which
# is a real nightly run, and on 2026-09-15 that put six digests of fixture data
# in the owner's inbox. To send one deliberately from a local run, put it on the
# command and not in this file: EMAIL_SEND=1 pnpm dev. A value left here would
# hand the test suite your inbox back.

# The private design system, @ncomeaux3/holon-ui on GitHub Packages. A classic
# PAT with read:packages only. pnpm ignores a credential in the project .npmrc,
# so this is not read from .env: set it where pnpm trusts it.
#   Local:  pnpm config set //npm.pkg.github.com/:_authToken <token>  (user ~/.npmrc)
#   CI:     repo secret NODE_AUTH_TOKEN (ci.yml writes it to user config)
#   Vercel: env var NPM_RC holding the two lines; vercel.json installCommand
#           writes it to the build user's ~/.npmrc (NPM_RC alone did not reach pnpm)
#           @ncomeaux3:registry=https://npm.pkg.github.com
#           //npm.pkg.github.com/:_authToken=<token>
#   Name: NODE_AUTH_TOKEN (a CI secret, never an .env line; pnpm setup reads every KEY= above)
