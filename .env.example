# Infrastructure secrets only. Account credentials for providers (Anthropic,
# Voyage, Resend, SimpleFIN, Strava...) are entered on Settings > Connections
# and stored encrypted in core.connections. Never add a provider key here.
#
# cp .env.example .env and fill every key. pnpm setup checks that none is blank.
# For local development, `supabase status` prints the first four values.

# Supabase. Local defaults are the well known dev values printed by
# `supabase status`; production values come from the project dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection, used by scripts, migrations, and tests.
# Local: postgresql://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_URL=

# The one account allowed to log in. Every other address is rejected.
OWNER_EMAIL=

# Base64 32 byte key for core/crypto.ts. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rotating this makes every stored connection credential unreadable.
ENCRYPTION_KEY=

# Shared secret on /api/cron/nightly and the dashboard Run now button.
# Generate with: openssl rand -hex 32
CRON_SECRET=

# Bearer token for /api/mcp, used by Claude Code.
# Generate with: openssl rand -hex 32
MCP_TOKEN=

# OAuth client credentials, one pair per oauth2 provider. Strava is the only
# one in the plan. Leave blank until the Fitness module ships.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
